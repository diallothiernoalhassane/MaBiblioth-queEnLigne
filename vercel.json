{
  "builds": [
    {
      "src": "FrontEnd/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "https://mabiblioth-queenligne.onrender.com/api/$1" },
    { "src": "/(.*)", "dest": "/FrontEnd/index.html" }
  ],
  "functions": {
    "FrontEnd/**/*.html": {
      "maxDuration": 10
    }
  }
}
